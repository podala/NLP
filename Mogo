# Step 8: MQL generator

The MQL Generator converts the approved plan into MongoDB syntax.

```javascript
db.rpt_runs.aggregate([
  {
    $match: {
      rptId: "RPT-10025"
    }
  },
  {
    $limit: 1
  },
  {
    $lookup: {
      from: "clients",
      localField: "clientId",
      foreignField: "clientId",
      as: "client"
    }
  },
  {
    $lookup: {
      from: "rpt_exceptions",
      let: {
        currentRptId: "$rptId"
      },
      pipeline: [
        {
          $match: {
            $expr: {
              $eq: [
                "$rptId",
                "$$currentRptId"
              ]
            }
          }
        },
        {
          $group: {
            _id: {
              exceptionType: "$exceptionType",
              severity: "$severity"
            },
            count: {
              $sum: {
                $ifNull: [
                  "$count",
                  1
                ]
              }
            },
            descriptions: {
              $addToSet: "$description"
            }
          }
        },
        {
          $project: {
            _id: 0,
            exceptionType: "$_id.exceptionType",
            severity: "$_id.severity",
            count: 1,
            descriptions: 1
          }
        }
      ],
      as: "exceptions"
    }
  },
  {
    $project: {
      _id: 0,
      rptId: 1,
      clientId: 1,
      clientName: {
        $arrayElemAt: [
          "$client.clientName",
          0
        ]
      },
      status: 1,
      runDate: 1,
      totalClaims: 1,
      totalRebate: 1,
      approvalStatus: 1,
      exceptionCount: {
        $sum: "$exceptions.count"
      },
      exceptions: 1
    }
  }
])
```

